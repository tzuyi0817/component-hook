{
  "name": "@component-hook/eslint-plugin",
  "version": "1.5.1",
  "description": "ESLint config for component hook",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "oxfmt"
  ],
  "homepage": "https://github.com/tzuyi0817/component-hook/tree/master/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/tzuyi0817/component-hook/issues"
  },
  "license": "MIT",
  "author": "Tzuyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzuyi0817/component-hook.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "dev": "eslint-config-inspector --config ../../eslint.config.js",
    "build": "pnpm run build:typegen && tsdown",
    "build:typegen": "node scripts/typegen.ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxfmt": "^0.26.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "eslint-typegen": "^2.3.1",
    "oxfmt": "^0.71.0"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "oxfmt": ">=0.71.0"
  },
  "packageManager": "pnpm@12.4.2"
}
